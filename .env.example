# TriageVoice AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Google Gemini API key (server-side only, never expose to frontend)
GEMINI_API_KEY=

# Gemma model to use for clinical extraction (supports Gemma 4 MoE architecture)
# Configured: gemma-4-26b-a4b-it (26B total parameters, active 4B per token MoE)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Transcription model for voice-to-text audio processing
TRANSCRIBE_MODEL=gemini-3.8-flash

# Backend port
PORT=8080

# Set to true to use deterministic mock fixtures instead of calling the API
# When GEMINI_API_KEY is missing, DEMO_MODE is forced to true automatically
DEMO_MODE=true

# Frontend dev server port (used by Vite)
VITE_PORT=5173

# Backend URL used by the frontend (no trailing slash)
VITE_API_URL=http://localhost:8080
